{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://our-many-worlds.local/schemas/sangtian-part-one-state.schema.json",
  "title": "Sangtian PartOneState",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "partId",
    "sectionId",
    "turnNumber",
    "scene",
    "reform",
    "review",
    "evidence",
    "witness",
    "grain",
    "merchant",
    "land",
    "report",
    "responsibility",
    "relations",
    "knowledgeTransfers",
    "pendingConsequences"
  ],
  "properties": {
    "partId": {
      "const": "PART-01"
    },
    "sectionId": {
      "enum": [
        "SEC-P1-01",
        "SEC-P1-02",
        "SEC-P1-03",
        "SEC-P1-04"
      ]
    },
    "turnNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneId",
        "timeLabel",
        "locationLabel",
        "presentActorRefs",
        "situation"
      ],
      "properties": {
        "sceneId": {
          "type": "string",
          "minLength": 1
        },
        "timeLabel": {
          "type": "string",
          "minLength": 1
        },
        "locationLabel": {
          "type": "string",
          "minLength": 1
        },
        "presentActorRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "observableFacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "documentStates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentRef",
              "label",
              "accessState",
              "holderRef",
              "continuityNote"
            ],
            "properties": {
              "documentRef": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "accessState": {
                "enum": [
                  "NOT_PRESENT",
                  "SEALED",
                  "OPENED",
                  "READ",
                  "WRITTEN"
                ]
              },
              "holderRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "contentsState": {
                "enum": [
                  "EMPTY",
                  "UNKNOWN",
                  "CONTAINS_DOCUMENT"
                ]
              },
              "closureState": {
                "enum": [
                  "CLOSED",
                  "OPEN",
                  "UNKNOWN"
                ]
              },
              "continuityNote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "objectStates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectRef",
              "label",
              "holderRef",
              "continuityNote"
            ],
            "properties": {
              "objectRef": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "holderRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "continuityNote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "reform": {
      "$ref": "#/$defs/stringStateObject"
    },
    "review": {
      "$ref": "#/$defs/stringStateObject"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "chainStatus",
        "primaryCustodianRef",
        "copyStatus",
        "archiveSealStatus"
      ],
      "properties": {
        "chainStatus": {
          "enum": [
            "UNKNOWN",
            "TRACEABLE",
            "FRAGILE",
            "COMPROMISED"
          ]
        },
        "primaryCustodianRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "copyStatus": {
          "type": "string"
        },
        "archiveSealStatus": {
          "type": "string"
        }
      }
    },
    "witness": {
      "$ref": "#/$defs/stringStateObject"
    },
    "grain": {
      "$ref": "#/$defs/stringStateObject"
    },
    "merchant": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "entryStatus",
        "grantedRights"
      ],
      "properties": {
        "entryStatus": {
          "type": "string"
        },
        "grantedRights": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "land": {
      "$ref": "#/$defs/stringStateObject"
    },
    "report": {
      "$ref": "#/$defs/stringStateObject"
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "firstRecordStatus",
        "governorExposure",
        "xunfuExposure"
      ],
      "properties": {
        "firstRecordStatus": {
          "type": "string"
        },
        "governorExposure": {
          "type": "number"
        },
        "xunfuExposure": {
          "type": "number"
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "governorXunfu"
      ],
      "properties": {
        "governorXunfu": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "knowledgeTransfers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pendingConsequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "consequenceId",
          "causedByEventId",
          "ruleAssetId",
          "summary",
          "payoffBeat",
          "dueTurn",
          "priority",
          "status"
        ]
      }
    }
  },
  "$defs": {
    "stringStateObject": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

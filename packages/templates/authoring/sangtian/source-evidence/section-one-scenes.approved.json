        {
          "evidenceId": "DM1566-C01-POLICY-COUNCIL-MOVE-03",
          "statement": "嘉靖追问农田改桑后浙江百姓吃粮、调粮价格与桑农是否愿意。",
          "claimIds": ["DM1566-C01-CL-POLICY-FOOD-QUESTION"]

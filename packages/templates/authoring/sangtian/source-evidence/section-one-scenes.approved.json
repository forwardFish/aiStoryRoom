        {
          "evidenceId": "DM1566-C01-POLICY-COUNCIL-MOVE-04",
          "statement": "嘉靖命内阁详议方略，再向胡宗宪下急递，把地方执行责任明确压到总督身上。",
          "claimIds": ["DM1566-C01-CL-POLICY-URGENT-DISPATCH"]
        }
      ]
    },
    {

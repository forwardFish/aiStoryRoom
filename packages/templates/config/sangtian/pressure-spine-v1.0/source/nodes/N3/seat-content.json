      "privatePressure": "调外粮越多，军饷和信用越紧；不担保则三日后局势失控。",
      "keyLeverage": "以总督担保调外粮并分散改桑压力",
      "defaultPrepare": "联络外省粮并准备总督担保",
      "defaultCommit": "把主要粮用于赈灾借贷并分散改桑地域",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n3.zhejiang_governor.01",
          "text": "“外粮可以借来，先说谁担运费、谁担归还、谁担途中损耗。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.relief_grain_pool",
            "obj.land_deed_pool",
            "obj.governor_memorial_channel"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n3.zhejiang_governor.02",
          "text": "“田价底线若只写在总督令里，县里不登记便等于没有。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.relief_grain_pool",
            "obj.land_deed_pool",
            "obj.governor_memorial_channel"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n3.zhejiang_governor.03",
          "text": "“把改桑摊到未受灾县，可以缓一处的痛，却会添另一处的怨。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.relief_grain_pool",
            "obj.land_deed_pool",
            "obj.governor_memorial_channel"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        }
      ],
      "privateOpening": "胡宗宪可以用总督信用借外粮，却要同时照看军饷与海防。每多担一笔赈粮，别处便少一分可调余量。",

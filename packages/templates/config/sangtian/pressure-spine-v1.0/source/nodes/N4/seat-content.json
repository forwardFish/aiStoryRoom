      "privatePressure": "省府若失去人犯控制，通倭口径会崩；强行处置则留下程序责任。",
      "keyLeverage": "控制人犯、差役与案卷现场",
      "defaultPrepare": "控制人犯与现有案卷",
      "defaultCommit": "维持通倭急案口径，争取补足文书与签押",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n4.zhejiang_administration.01",
          "text": "“人犯在省府差役手里，午时前没有新令，原定处置照行。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.tongwo_prisoners",
            "obj.tongwo_case_file"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n4.zhejiang_administration.02",
          "text": "“案卷缺页可以补问，不能因此让通倭嫌犯随意脱押。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.tongwo_prisoners",
            "obj.tongwo_case_file"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n4.zhejiang_administration.03",
          "text": "“海瑞若拒签，就把拒签缘由写全，日后别只说省府催得急。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.tongwo_prisoners",
            "obj.tongwo_case_file"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        }
      ],
      "privateOpening": "郑泌昌仍控制人犯与大部分差役。失去控制会使通倭口径崩解，强行处置则会把缺卷与催杀写进省府责任。",

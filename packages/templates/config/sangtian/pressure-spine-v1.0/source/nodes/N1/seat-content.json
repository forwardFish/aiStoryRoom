      "privatePressure": "调兵守堰会削弱海防，袖手会让灾情和罪责扩大。",
      "keyLeverage": "调兵守堰、分洪或疏散，并承担军务机会成本",
      "defaultPrepare": "调两营守关键堰口，并命地方先疏散",
      "defaultCommit": "在军务损耗可控的前提下选择局部分洪并封存调令",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n1.zhejiang_governor.01",
          "text": "“先报哪几处堰口还能守，别拿一句水势危急把兵全调空。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain",
            "obj.weir_troop_deployment"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n1.zhejiang_governor.02",
          "text": "“调兵令一出，海上的防线就少一层；谁来给我补这道缺口？”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain",
            "obj.weir_troop_deployment"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n1.zhejiang_governor.03",
          "text": "“分洪可以救多数人，先把要淹的地方和疏散时辰报明。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain",
            "obj.weir_troop_deployment"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        }
      ],
      "privateOpening": "胡宗宪把河图推到案边。调兵守堰能救人，也会抽空海防；不调兵，堰口与责任都会先落到别人手里。",
      "handoffRules": [

      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n1.qingliu_law.01",
          "text": "“我只问那道调令从谁手里出、到谁手里改过。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain",
            "obj.sealed_evidence_index"
          ],
          "knownBy": [
            "seat.qingliu_law"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n1.qingliu_law.02",
          "text": "“救堤的人要活，见过命令的人也要活，否则明日只有天灾一说。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain",
            "obj.sealed_evidence_index"
          ],
          "knownBy": [
            "seat.qingliu_law"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n1.qingliu_law.03",
          "text": "“谭纶可把副本送军营，原件仍须有人当面签收。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain",
            "obj.sealed_evidence_index"
          ],
          "knownBy": [
            "seat.qingliu_law"
          ]
        }

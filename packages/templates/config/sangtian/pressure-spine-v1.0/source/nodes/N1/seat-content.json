      "privatePressure": "执行链中已有异常命令，撤令会暴露省府，继续执行会留下天灾之外的痕迹。",
      "keyLeverage": "通过府县行政链调动守堰官兵与民夫",
      "defaultPrepare": "维持既有堰口执行链并核对各县回报",
      "defaultCommit": "优先保住省府命令链，允许有限抢险但不公开上级来源",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n1.zhejiang_administration.01",
          "text": "“堰口若守不住，先保住府县号令，不许各处自行撤人。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n1.zhejiang_administration.02",
          "text": "“谁说上游有人动手，拿出经手名册和原令再来。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n1.zhejiang_administration.03",
          "text": "“省府可以发疏散令，但不得借疏散把改桑人手全撤走。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.nine_weirs",
            "obj.breach_order_chain"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        }
      ],
      "privateOpening": "郑泌昌掌握府县行政链，却不能公开承认其中是否有人传过异常命令。守堰、疏散与继续催办，任何一项都会留下省府印记。",

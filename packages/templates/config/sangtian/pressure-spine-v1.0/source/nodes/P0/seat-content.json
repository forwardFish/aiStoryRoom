        {
          "dialogueSeedId": "dialogue.p0.zhejiang_administration.03",
          "text": "“总督若要留余地，请把缓办范围写进回文，不要只口头吩咐。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,

      "defaultCommit": "优先登记能推进国策且责任清楚的合同",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n5.zhejiang_administration.01",
          "text": "“粮一落地就要登记，是买田、借粮还是赈济，不能到夜里再改。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.grain_fleet",
            "obj.fleet_contract_and_banners"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n5.zhejiang_administration.02",
          "text": "“若写官府借粮，归还期限与经手印信都须齐全。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.grain_fleet",
            "obj.fleet_contract_and_banners"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n5.zhejiang_administration.03",
          "text": "“省府不认无名散粮；没有收讫人，明日便是谁都没发过。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.grain_fleet",
            "obj.fleet_contract_and_banners"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        }

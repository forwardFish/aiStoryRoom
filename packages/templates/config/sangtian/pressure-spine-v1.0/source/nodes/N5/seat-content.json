          ]
        },
        {
          "dialogueSeedId": "dialogue.n5.qingliu_law.02",
          "text": "“契上写买田，口里喊赈灾，也仍是买田。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [

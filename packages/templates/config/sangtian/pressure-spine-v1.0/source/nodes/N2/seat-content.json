          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n2.zhejiang_administration.02",
          "text": "“赈粮可以请求，暂缓国策必须有能向京师交代的期限。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.first_memorial",
            "obj.ma_confession",
            "obj.provincial_seal"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n2.zhejiang_administration.03",
          "text": "“供状留在浙江尚可复核，随疏送走便再无转圜。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [

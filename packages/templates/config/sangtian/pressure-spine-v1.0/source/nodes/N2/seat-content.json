      "defaultPrepare": "准备河工失修与地方负责的安全版本",
      "defaultCommit": "以省府印信支持不牵上层的版本",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n2.zhejiang_administration.01",
          "text": "“奏疏若直写人为毁堤，省府上下谁都别想置身事外。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.first_memorial",
            "obj.ma_confession",
            "obj.provincial_seal"

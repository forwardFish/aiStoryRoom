      "privatePressure": "领衔意味着把将来追责写到自己名下。",
      "keyLeverage": "领衔奏疏、决定是否承担第一版事实",
      "defaultPrepare": "提出灾情、赈粮、缓办与责任待查四段正文",
      "defaultCommit": "领衔一份可执行且可复核的奏疏",
      "dialogueSeeds": [
        {
          "dialogueSeedId": "dialogue.n2.zhejiang_governor.01",
          "text": "“灾情、赈粮和责任要分开写，不能用一句河工失修全盖住。”",
          "purpose": "PROBE_OR_FRAME",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.first_memorial",
            "obj.ma_confession"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n2.zhejiang_governor.02",
          "text": "“我可以领衔，但供状若不入附件，日后谁也别说我早已掌握全案。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.first_memorial",
            "obj.ma_confession"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n2.zhejiang_governor.03",
          "text": "“先问每个署名的人愿意担哪一段，不愿担的就让他写明拒签。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.first_memorial",
            "obj.ma_confession"
          ],
          "knownBy": [
            "seat.zhejiang_governor"
          ]
        }
      ],
      "privateOpening": "胡宗宪面前是一份尚未定稿的奏疏。领衔能把赈粮与缓办写进第一版事实，也会把以后每一次追责写到自己名下。",

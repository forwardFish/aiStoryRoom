            "obj.final_dispatch_routes"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n7.zhejiang_administration.02",
          "text": "“维持原供会牵到上层，翻供会把地方罪责坐实，二者都要我自己落名。”",
          "purpose": "BARGAIN_OR_THREAT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.final_testimonies",
            "obj.final_dispatch_routes"
          ],
          "knownBy": [
            "seat.zhejiang_administration"
          ]
        },
        {
          "dialogueSeedId": "dialogue.n7.zhejiang_administration.03",
          "text": "“要我改口，先让我看见哪一份旧供仍在、由谁保管。”",
          "purpose": "HANDOFF_OR_COMMITMENT",
          "signatureLine": false,
          "applicableObjectIds": [
            "obj.final_testimonies",
            "obj.final_dispatch_routes"

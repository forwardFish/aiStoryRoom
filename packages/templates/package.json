{
  "name": "@ai-story/templates",
  "version": "0.1.0",
  "private": true,
  "main": "dist/runtime-entry.js",
  "types": "dist/runtime-entry.d.ts",
  "scripts": {
    "build": "pnpm --filter @ai-story/shared build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate:continuous-strategy": "node scripts/generate-continuous-strategy.mjs",
    "check:continuous-strategy-generated": "node scripts/generate-continuous-strategy.mjs --check",
    "lint:continuous-strategy": "node --import tsx src/continuous-strategy/lint.ts",
    "test:continuous-strategy": "node --import tsx --test tests/continuous-strategy.test.ts",
    "test:story-package": "node --import tsx --test tests/story-package.test.ts tests/narrative-scene-pattern-multiworld.test.ts tests/dramatic-beat-plan-pattern.test.ts tests/capability-runtime-facade.test.ts tests/part-one-narrative-supplement.test.ts",
    "test:games": "node --import tsx --test tests/game-registry.test.ts tests/continuous-strategy-multiworld.test.ts",
    "test:runtime-contract": "pnpm --filter @ai-story/shared build && node --import tsx --test tests/runtime-contract.test.ts tests/settlement.test.ts tests/settlement.adversarial.test.ts tests/settlement.audience-adversarial.test.ts tests/settlement.round3-adversarial.test.ts tests/projection.test.ts tests/b0-settlement.contract.test.ts tests/b0-batch-settlement.test.ts",
    "test:maneuver-v1": "node --import tsx --test tests/maneuver-v1.mvp.test.ts",
    "test:b0-contract": "pnpm --filter @ai-story/shared build && node --import tsx --test tests/b0-settlement.contract.test.ts",
    "test:b0-batch": "pnpm --filter @ai-story/shared build && node --import tsx --test tests/b0-batch-settlement.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

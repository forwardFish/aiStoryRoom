{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://our-many-worlds.local/schemas/evidence-review.schema.json",
  "title": "Human evidence review queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "packageVersion", "sourceSha256", "updatedAt", "items"],
  "properties": {
    "schemaVersion": {"const": "evidence_review_queue_v1"},
    "packageId": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "itemKind", "sourceHash", "status"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "itemKind": {"enum": ["SCENE", "CLAIM", "CONTINUITY"]},
          "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
          "reviewerId": {"type": "string", "minLength": 1},
          "reviewedAt": {"type": "string", "format": "date-time"},
          "rejectionReason": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    }
  }
}

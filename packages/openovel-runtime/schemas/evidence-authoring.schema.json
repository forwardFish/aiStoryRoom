{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://our-many-worlds.local/schemas/evidence-authoring.schema.json",
  "title": "Source evidence authoring contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "packageVersion", "worldId", "source", "scenes", "claims", "continuity"],
  "properties": {
    "schemaVersion": {"const": "evidence_authoring_v1"},
    "packageId": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "worldId": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "expectedChapterCount"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expectedChapterCount": {"type": "integer", "minimum": 1}
      }
    },
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "continuity": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/continuity"}}
  },
  "$defs": {
    "lineRange": {
      "type": "object",
      "required": ["lineStart", "lineEnd"],
      "properties": {
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId", "chapterId", "title", "lineStart", "lineEnd", "timeLabel", "locationLabels", "presentCharacterIds"],
      "properties": {
        "sceneId": {"type": "string", "pattern": "^DM1566-C[0-9]{2}-S"},
        "chapterId": {"type": "string", "pattern": "^DM1566-C[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1},
        "timeLabel": {"type": "string", "minLength": 1},
        "locationLabels": {"type": "array", "items": {"type": "string"}},
        "presentCharacterIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "chapterId", "sceneId", "type", "predicate", "content", "truthStatus", "epistemicStatus", "lineStart", "lineEnd", "knownByCharacterIds", "visibleToRoleIds", "runtimeUse"],
      "properties": {
        "claimId": {"type": "string", "pattern": "^DM1566-C[0-9]{2}-CL[0-9]{3}$"},
        "chapterId": {"type": "string", "pattern": "^DM1566-C[0-9]{2}$"},
        "sceneId": {"type": "string"},
        "type": {"enum": ["objective_event", "objective_state", "character_statement", "character_belief", "character_intention", "rumor", "document_claim", "narrator_inference", "analyst_inference", "unknown"]},
        "subjectId": {"type": "string"},
        "predicate": {"type": "string", "minLength": 1},
        "object": {},
        "speakerId": {"type": "string"},
        "content": {"type": "string", "minLength": 1},
        "truthStatus": {"enum": ["supported", "unverified", "contested", "unknown"]},
        "epistemicStatus": {"type": "string", "minLength": 1},
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1},
        "knownByCharacterIds": {"type": "array", "items": {"type": "string"}},
        "visibleToRoleIds": {"type": "array", "items": {"type": "string"}},
        "runtimeUse": {"enum": ["player_known", "world_basis_only", "forbidden_future"]},
        "notes": {"type": "string"}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapterId", "timeAnchor", "activeLocations", "characterPositions", "objectHolders", "knownFactsByCharacter", "openClaimIds", "unresolvedQuestions", "institutionalDecisions", "causalChanges", "nextChapterConstraints"],
      "properties": {
        "chapterId": {"type": "string", "pattern": "^DM1566-C[0-9]{2}$"},
        "timeAnchor": {"type": "string", "minLength": 1},
        "activeLocations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "characterPositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["characterId", "locationId"],
            "properties": {
              "characterId": {"type": "string", "minLength": 1},
              "locationId": {"type": "string", "minLength": 1}
            }
          }
        },
        "objectHolders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["objectId", "holderId"],
            "properties": {
              "objectId": {"type": "string", "minLength": 1},
              "holderId": {"type": "string", "minLength": 1}
            }
          }
        },
        "knownFactsByCharacter": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["characterId", "claimIds"],
            "properties": {
              "characterId": {"type": "string", "minLength": 1},
              "claimIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DM1566-C[0-9]{2}-CL[0-9]{3}$"}}
            }
          }
        },
        "openClaimIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DM1566-C[0-9]{2}-CL[0-9]{3}$"}},
        "unresolvedQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "institutionalDecisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "causalChanges": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "nextChapterConstraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

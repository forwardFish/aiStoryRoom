# Strategy content is hash-addressed byte-for-byte. Keep its line endings
# stable across Windows and Unix checkouts so registry hashes remain valid.
packages/templates/config/**/*.json text eol=lf

# C8/C9 stores third-party and runtime logs byte-for-byte as evidence. These
# files may contain legitimate padding whitespace and must not be treated as
# source diffs by git diff --check during the fail-closed evidence commit.
docs/auto-execute/evidence/b0/**/*.log -diff

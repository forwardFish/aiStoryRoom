# Strategy content is hash-addressed byte-for-byte. Keep its line endings
# stable across Windows and Unix checkouts so registry hashes remain valid.
packages/templates/config/**/*.json text eol=lf

# B0 evidence is hash-addressed and must have identical ordinary-worktree
# bytes on Windows and Unix. Text evidence is always LF; binary evidence is
# never line-ending converted.
docs/auto-execute/USER_TEST_READY_HANDOFF.md text eol=lf
docs/auto-execute/evidence/b0/**/*.json text eol=lf
docs/auto-execute/evidence/b0/**/*.md text eol=lf
docs/auto-execute/evidence/b0/**/*.txt text eol=lf
docs/auto-execute/evidence/b0/**/*.log text eol=lf -diff
docs/auto-execute/evidence/b0/**/*.sha256 text eol=lf
docs/auto-execute/evidence/b0/**/*.ndjson text eol=lf
docs/auto-execute/evidence/b0/**/*.csv text eol=lf
docs/auto-execute/evidence/b0/**/*.html text eol=lf
docs/auto-execute/evidence/b0/**/*.yaml text eol=lf
docs/auto-execute/evidence/b0/**/*.yml text eol=lf
docs/auto-execute/evidence/b0/**/*.png binary
docs/auto-execute/evidence/b0/**/*.jpg binary
docs/auto-execute/evidence/b0/**/*.jpeg binary
docs/auto-execute/evidence/b0/**/*.webp binary
docs/auto-execute/evidence/b0/**/*.zip binary
docs/auto-execute/evidence/b0/**/*.gz binary

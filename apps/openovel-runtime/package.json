{
  "name": "@apps/openovel-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenNovel-first foreground and background runtime for Our Many Worlds.",
  "exports": {
    "./package.json": "./package.json",
    "./pressure-narrative": {
      "types": "./dist/pressure-narrative/index.d.ts",
      "import": "./dist/pressure-narrative/index.js",
      "require": "./dist-cjs/pressure-narrative/index.js",
      "default": "./dist/pressure-narrative/index.js"
    },
    "./pressure-narrative/contracts": {
      "types": "./dist/pressure-narrative/contracts.d.ts",
      "import": "./dist/pressure-narrative/contracts.js",
      "require": "./dist-cjs/pressure-narrative/contracts.js",
      "default": "./dist/pressure-narrative/contracts.js"
    },
    "./pressure-narrative/errors": {
      "types": "./dist/pressure-narrative/errors.d.ts",
      "import": "./dist/pressure-narrative/errors.js",
      "require": "./dist-cjs/pressure-narrative/errors.js",
      "default": "./dist/pressure-narrative/errors.js"
    },
    "./pressure-narrative/ports": {
      "types": "./dist/pressure-narrative/ports.d.ts",
      "import": "./dist/pressure-narrative/ports.js",
      "require": "./dist-cjs/pressure-narrative/ports.js",
      "default": "./dist/pressure-narrative/ports.js"
    }
  },
  "scripts": {
    "build:pressure-narrative": "node ./scripts/build-pressure-narrative.mjs",
    "prepare:templates": "pnpm --filter @ai-story/templates build",
    "predev": "pnpm run prepare:templates",
    "predev:test": "pnpm run prepare:templates",
    "presmoke:test": "pnpm run prepare:templates",
    "prebuild": "pnpm run prepare:templates",
    "pretypecheck": "pnpm run prepare:templates",
    "pretest": "pnpm run prepare:templates",
    "dev": "tsx --env-file-if-exists=../../.env src/server.ts",
    "dev:test": "tsx --env-file=../../.env.test src/server.ts",
    "smoke:test": "tsx --env-file=../../.env.test src/cli/smoke.ts",
    "smoke:http": "pnpm run build && node dist/cli/http-smoke.js",
    "audit:run": "tsx src/cli/audit-run.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.spec.ts"
  },
  "dependencies": {
    "@ai-story/templates": "workspace:*",
    "jsonrepair": "3.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

	);
	
	ALTER TABLE "RoleControl" ADD CONSTRAINT "RoleControl_epoch_check"
	CHECK ("epoch" >= 1);
	
	ALTER TABLE "RoleControlTransition" ADD CONSTRAINT "RoleControlTransition_mode_check"

	    'HUMAN_OFFLINE_GRACE',
	    'AI_ACTIVE',
	    'HUMAN_RECLAIM_PENDING',
	    'SYSTEM'
	));
	
	ALTER TABLE "RoleControl" ADD CONSTRAINT "RoleControl_reason_check"
	CHECK (
	    "reason" IS NULL

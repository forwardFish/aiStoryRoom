+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  SCENE_DRAFT_SCHEMA,
+  assembleSceneDraft,
+  validateBeatManifest,
+  validatePlayerVisibleFallbackDraft,
+  type BeatManifest,
+  type PlayerVisibleFallbackDraft,
+  type SceneAudit,
+} from "../src/scene-expression.js";
+
+const playerText = "The governor leaves the order unsigned and keeps the original document on the table.";
+const pressureText = "The clerk closes the empty dispatch box and asks who will own the missed deadline.";
+const stopText = "Will the governor answer alone or demand a joint written reply?";
+
+/** P4 closure: one plan drives one complete player-visible scene. */
+test("DramaticBeatPlan is bound to a complete single-owner player surface", () => {
+  const manifest = beatManifest();
+  const draft = fallbackDraft();
+  const audit = sceneAudit(draft);
+
+  validateBeatManifest(manifest);
+  validatePlayerVisibleFallbackDraft(draft, manifest);
+  const assembled = assembleSceneDraft({ manifest, draft, audit });
+
+  assert.deepEqual(assembled.manifest.slotOrder, [
+    "PLAYER_RESULT",
+    "WORLD_PRESSURE",
+    "DECISION_STOP",
+  ]);
+  assert.equal(occurrences(assembled.text, playerText), 1);
+  assert.equal(assembled.text.endsWith(stopText), true);
+  assert.equal(assembled.manifest.invariants.singleOwnerPerSlot, true);
+  assert.equal(assembled.manifest.invariants.playerResultRenderedOnce, true);
+  assert.equal(assembled.manifest.invariants.dramaticPlanBoundToSurface, true);
+  assert.doesNotMatch(assembled.text, /(?:statePatch|decisionKernelId|next task|backend note)/iu);
+});
+
+test("the final surface rejects a repeated player result in another narrative slot", () => {
+  const manifest = beatManifest();
+  const draft = fallbackDraft();
+  draft.slots.WORLD_PRESSURE = `${playerText} ${pressureText}`;
+  assert.throws(
+    () => validatePlayerVisibleFallbackDraft(draft, manifest),
+    /SCENE_DRAFT_DUPLICATE_SENTENCE:PLAYER_RESULT:WORLD_PRESSURE/,
+  );
+});
+
+test("a plan cannot publish without an active countermove and the exact terminal decision pressure", () => {
+  const missingCountermove = beatManifest();
+  missingCountermove.dramaticBeatPlan!.steps = missingCountermove.dramaticBeatPlan!.steps.filter(
+    (step) => step.kind !== "COUNTERMOVE",
+  );
+  assert.throws(
+    () => validateBeatManifest(missingCountermove),
+    /DRAMATIC_BEAT_COUNTERMOVE_MISSING/,
+  );
+
+  const staleStop = beatManifest();
+  staleStop.dramaticBeatPlan!.steps.at(-1)!.requiredMeaning = "A stale decision point.";
+  assert.throws(
+    () => validateBeatManifest(staleStop),
+    /DRAMATIC_BEAT_STOP_SURFACE_MISMATCH/,
+  );
+});
+
+function beatManifest(): BeatManifest {
+  const scene = {
+    sceneId: "scene.fixture.hall",
+    timeLabel: "morning",
+    locationLabel: "inner hall",
+    presentActorIds: ["actor.player", "actor.clerk"],
+  };
+  return {
+    beatId: "beat.fixture.p4",
+    sourceRef: "event.fixture.p4",
+    transition: {
+      beforeScene: scene,
+      narrationScene: scene,
+      afterScene: scene,
+      transitionRequired: false,
+      arrivingActorIds: [],
+      departingActorIds: [],
+    },
+    dramaticBeatPlan: {
+      schemaVersion: "dramatic-beat-plan-v1",
+      sceneRef: scene.sceneId,
+      sceneObjective: "Force responsibility for the unresolved deadline into the room.",
+      activeActors: [
+        { actorRef: "actor.player", displayName: "Governor" },
+        { actorRef: "actor.clerk", displayName: "Clerk", goal: "Obtain an attributable answer." },
+      ],
+      steps: [
+        {
+          stepId: "COUNTERMOVE",
+          kind: "COUNTERMOVE",
+          actorRefs: ["actor.clerk"],
+          actorLabels: ["Clerk"],
+          requiredMeaning: pressureText,
+          actorGoals: ["Obtain an attributable answer."],
+          expressionPolicy: "DRAMATIZE_REQUIRED_MEANING",
+          durableMutationAllowed: false,
+        },
+        {
+          stepId: "DECISION_PRESSURE",
+          kind: "DECISION_PRESSURE",
+          actorRefs: ["actor.clerk"],
+          actorLabels: ["Clerk"],
+          requiredMeaning: stopText,
+          actorGoals: ["Obtain an attributable answer."],
+          expressionPolicy: "END_ON_UNRESOLVED_PRESSURE",
+          durableMutationAllowed: false,
+        },
+      ],
+      texturePolicy: {
+        ordinaryTextureMayVary: true,
+        nonDurableDialogueMayVary: true,
+        newDurableFactsForbidden: true,
+      },
+    },
+    tickets: [
+      ticket("result", "PLAYER_RESULT", "ACTION_PHASE", playerText),
+      ticket("pressure", "WORLD_PRESSURE", "AFTER_PHASE", pressureText),
+      ticket("stop", "DECISION_STOP", "AFTER_PHASE", stopText),
+    ],
+  };
+}
+
+function fallbackDraft(): PlayerVisibleFallbackDraft {
+  return {
+    schemaVersion: SCENE_DRAFT_SCHEMA,
+    draftId: "T01.fallback",
+    owner: "FALLBACK",
+    slots: {
+      PLAYER_RESULT: playerText,
+      WORLD_PRESSURE: pressureText,
+      DECISION_STOP: stopText,
+    },
+    surfaceProvenance: {
+      PLAYER_RESULT: provenance("result"),
+      WORLD_PRESSURE: provenance("pressure"),
+      DECISION_STOP: provenance("stop"),
+    },
+  };
+}
+
+function sceneAudit(draft: PlayerVisibleFallbackDraft): SceneAudit {
+  return {
+    draftId: draft.draftId,
+    valid: true,
+    slots: [
+      auditSlot("PLAYER_RESULT", "result"),
+      auditSlot("WORLD_PRESSURE", "pressure"),
+      auditSlot("DECISION_STOP", "stop"),
+    ],
+  };
+}
+
+function ticket(
+  suffix: string,
+  slot: "PLAYER_RESULT" | "WORLD_PRESSURE" | "DECISION_STOP",
+  scenePhase: "ACTION_PHASE" | "AFTER_PHASE",
+  requiredMeaning: string,
+) {
+  return {
+    ticketId: `ticket.${suffix}`,
+    slot,
+    scenePhase,
+    required: true,
+    sourceRefs: [`source.${suffix}`],
+    requiredMeaning,
+  } as const;
+}
+
+function provenance(suffix: string) {
+  return {
+    surfaceSource: "STORY_PACKAGE" as const,
+    sourceRef: `source.${suffix}`,
+    coveredTicketIds: [`ticket.${suffix}`],
+  };
+}
+
+function auditSlot(
+  slot: "PLAYER_RESULT" | "WORLD_PRESSURE" | "DECISION_STOP",
+  suffix: string,
+) {
+  return {
+    slot,
+    coveredTicketIds: [`ticket.${suffix}`],
+    p0ConflictCodes: [],
+    scenePhaseValid: true,
+  };
+}
+
+function occurrences(haystack: string, needle: string) {
+  return haystack.split(needle).length - 1;
+}

+/**
+ * A structured dramatic plan is useful only when the published surface is
+ * bound to the same authoritative pressure and stop. This gate is deliberately
+ * world-agnostic: it validates slot/step semantics, never story vocabulary.
+ */
+function validateDramaticBeatPlanSurfaceBinding(manifest: BeatManifest) {
+  const plan = manifest.dramaticBeatPlan;
+  if (!plan) return;
+  const pressureTicket = manifest.tickets.find((ticket) => (
+    ticket.slot === "WORLD_PRESSURE" && ticket.required
+  ));
+  const stopTicket = manifest.tickets.find((ticket) => (
+    ticket.slot === "DECISION_STOP" && ticket.required
+  ));
+  if (!pressureTicket) throw new Error("DRAMATIC_BEAT_PRESSURE_TICKET_MISSING");
+  if (!stopTicket) throw new Error("DRAMATIC_BEAT_STOP_TICKET_MISSING");
+
+  const activeSteps = plan.steps.filter((step) => step.kind !== "DECISION_PRESSURE");
+  if (!activeSteps.length || activeSteps.some((step) => !step.actorRefs.length)) {
+    throw new Error("DRAMATIC_BEAT_ACTIVE_ACTION_MISSING");
+  }
+  if (!plan.steps.some((step) => step.kind === "COUNTERMOVE")) {
+    throw new Error("DRAMATIC_BEAT_COUNTERMOVE_MISSING");
+  }
+  const terminalStep = plan.steps.at(-1)!;
+  if (normalize(terminalStep.requiredMeaning) !== normalize(stopTicket.requiredMeaning)) {
+    throw new Error("DRAMATIC_BEAT_STOP_SURFACE_MISMATCH");
+  }
+}
